# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL connection (local docker-compose default shown; Neon in production)
DATABASE_URL=postgres://monevo:monevo_dev_password@localhost:5432/monevo
# "true" for Neon / any managed Postgres
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed by CORS (mobile apps don't need CORS; web build does). Use * only in dev.
CORS_ORIGINS=*

# Apply pending DB migrations when the server boots (useful on Render free tier)
RUN_MIGRATIONS_ON_START=false

# Expose Swagger UI at /docs
ENABLE_API_DOCS=true

